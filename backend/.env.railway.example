# Referensi environment variable untuk deployment di Railway.
# Salin nilai-nilai ini ke tab "Variables" pada service Railway (bukan file .env).
# Tidak dipakai otomatis — hanya dokumentasi, karena setup lokal tetap pakai backend/.env sendiri.

APP_NAME="Monitoring K3 Puskesmas"
APP_ENV=production
APP_DEBUG=false
# Generate sekali secara lokal: php artisan key:generate --show
APP_KEY=
# Domain yang diberikan Railway, contoh: https://k3-puskesmas.up.railway.app
APP_URL=https://<domain-railway-anda>

# Karena frontend & backend dilayani dari satu domain (lihat Dockerfile), SESSION_DOMAIN
# cukup dibiarkan kosong. Yang WAJIB diisi adalah SANCTUM_STATEFUL_DOMAINS (host saja,
# tanpa https:// dan tanpa trailing slash) agar cookie login (Sanctum SPA) dipercaya.
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=<domain-railway-anda>
FRONTEND_URL=https://<domain-railway-anda>

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Tambahkan plugin MySQL di Railway, lalu isi 5 variable ini dari variable yang
# disediakan plugin tersebut (biasanya MYSQLHOST, MYSQLPORT, MYSQLDATABASE, MYSQLUSER, MYSQLPASSWORD).
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
